<local:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.NotificationCenterWindow"
        Style="{StaticResource Window.Chrome}"
        Title="{x:Static local:L.CenterTitle}"
        Icon="pack://application:,,,/Resources/homebase.ico"
        Width="500" Height="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Display">
  <!-- Notification center (DECISIONS M-32): what other devices relayed here, and this PC's alerts.
       Rows are built in code; filters are source chips. -->
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource SectionHeaderBar}" Margin="0,0,0,10" Padding="10,6">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                   FontFamily="{StaticResource Font.Display}" FontWeight="Black"
                   FontSize="16" Foreground="{StaticResource Brush.OnDark}" Text="HOMEBASE"/>
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,3,0,0"
                   Style="{StaticResource Type.Micro}" Foreground="{StaticResource Brush.Amber}"
                   Text="{x:Static local:L.CenterEyebrow}"/>
      </DockPanel>
    </Border>

    <WrapPanel x:Name="FilterPanel" Grid.Row="1" Margin="0,0,0,8"/>

    <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="ListPanel">
        <TextBlock Style="{StaticResource Type.Body}" Foreground="{StaticResource Brush.OnDark}"
                   Text="{x:Static local:L.CenterLoading}"/>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Carbon}" Content="{x:Static local:L.Close}"
              Margin="8,0,0,0" Click="Close_Click"/>
      <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource Button.Carbon}"
              Content="{x:Static local:L.CenterClear}" Margin="8,0,0,0" Click="Clear_Click" IsEnabled="False"/>
      <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource Button.Amber}"
              Content="{x:Static local:L.CenterMore}" Click="More_Click" Visibility="Collapsed"/>
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Type.Micro}"
                 Foreground="{StaticResource Brush.OnDark}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</local:ThemedWindow>
