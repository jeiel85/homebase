<local:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.SendPickerWindow"
        Style="{StaticResource Window.Chrome}"
        Title="Homebase"
        Icon="pack://application:,,,/Homebase.Tray;component/Resources/homebase.ico"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="True" Topmost="True"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource SectionHeaderBar}" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" Style="{StaticResource Type.SectionLabel}"/>
    </Border>

    <TextBlock Grid.Row="1" x:Name="SummaryText" Style="{StaticResource Type.BodyStrong}" TextWrapping="Wrap" Margin="2,0,2,10"/>

    <Border Grid.Row="2" Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel x:Name="TargetsPanel"/>
        <TextBlock x:Name="EmptyText" Style="{StaticResource Type.Body}" TextWrapping="Wrap" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Style="{StaticResource Button.Carbon}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="SendButton" Style="{StaticResource Button.Signal}" IsDefault="True" Click="Send_Click"/>
    </StackPanel>
  </Grid>
</local:ThemedWindow>
