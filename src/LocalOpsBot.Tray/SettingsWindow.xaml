<local:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.SettingsWindow"
        Style="{StaticResource Window.Chrome}"
        Title="{x:Static local:L.SettingsTitle}"
        Icon="pack://application:,,,/Resources/homebase.ico"
        Width="520" Height="660"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Display">
  <!-- Every tab reads top-down the same way: what this does → current state → change it →
       how it is applied (an amber admin note sits right above any button that asks for UAC). -->
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource SectionHeaderBar}" Margin="0,0,0,12" Padding="10,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}" FontWeight="Black"
                   FontSize="16" Foreground="{StaticResource Brush.OnDark}" Text="HOMEBASE"/>
        <TextBlock VerticalAlignment="Center" Margin="8,3,0,0" Style="{StaticResource Type.Micro}"
                   Foreground="{StaticResource Brush.Amber}" Text="{x:Static local:L.SettingsEyebrow}"/>
      </StackPanel>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource Tabs.Console}">

      <!-- ═══ Telegram ═══ -->
      <TabItem x:Name="TelegramTab" Header="{x:Static local:L.TabTelegram}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource SectionHeaderBar}">
              <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.TgHeader}"/>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.TgWhat}"/>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="TgChip" Style="{StaticResource Chip}">
                    <TextBlock x:Name="TgChipText" Style="{StaticResource ChipText}" Text="…"/>
                  </Border>
                  <TextBlock x:Name="TgStatusText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                             Style="{StaticResource Type.BodyStrong}" TextWrapping="Wrap" Text="{x:Static local:L.BadgeChecking}"/>
                </Grid>

                <TextBlock Style="{StaticResource Type.Label}" Margin="0,14,0,0" Text="{x:Static local:L.TgToken}"/>
                <PasswordBox x:Name="TokenInput" Margin="0,3,0,0" FontFamily="Consolas"/>
                <TextBlock Style="{StaticResource Type.Micro}" Margin="0,2,0,0" Text="{x:Static local:L.TgTokenHint}"/>

                <TextBlock Style="{StaticResource Type.Label}" Margin="0,10,0,0" Text="{x:Static local:L.TgChatId}"/>
                <TextBox x:Name="ChatIdInput" Margin="0,3,0,0" FontFamily="Consolas"/>
                <TextBlock Style="{StaticResource Type.Micro}" Margin="0,2,0,0" Text="{x:Static local:L.TgChatIdHint}"/>

                <Border Style="{StaticResource AdminNote}" Margin="0,14,0,0">
                  <DockPanel><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" DockPanel.Dock="Left"/><TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.TgSaveNote}"/></DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                  <Button x:Name="TestButton" Style="{StaticResource Button.Carbon}"
                          Content="{x:Static local:L.SendTest}" Click="TestMessage_Click"/>
                  <Button x:Name="SaveTelegramButton" Style="{StaticResource Button.Signal}" Margin="8,0,0,0"
                          Click="SaveTelegram_Click">
                    <StackPanel Orientation="Horizontal"><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock VerticalAlignment="Center" Text="{x:Static local:L.TgSave}"/></StackPanel>
                  </Button>
                </StackPanel>
                <TextBlock x:Name="TgResultText" Style="{StaticResource Type.BodyStrong}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionHeaderBar}">
              <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.TgFirstTime}"/>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap"><Run Text="1. "/><Run Text="{x:Static local:L.TgStep1}"/></TextBlock>
                <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Margin="0,3,0,0"><Run Text="2. "/><Run Text="{x:Static local:L.TgStep2}"/></TextBlock>
                <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Margin="0,3,0,0"><Run Text="3. "/><Run Text="{x:Static local:L.TgStep3}"/></TextBlock>
                <TextBlock Margin="0,8,0,0" FontFamily="{StaticResource Font.Sans}" FontSize="12" FontWeight="Bold">
                  <Hyperlink NavigateUri="https://t.me/botfather" RequestNavigate="Hyperlink_RequestNavigate"
                             Foreground="{StaticResource Brush.InkSoft}"><Run Text="{x:Static local:L.TgOpenBotFather}"/></Hyperlink>
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Notification forwarding ═══ -->
      <TabItem x:Name="ForwardingTab" Header="{x:Static local:L.TabForwarding}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource SectionHeaderBar}">
              <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.FwHeader}"/>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.FwWhat}"/>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="FwChip" Style="{StaticResource Chip}">
                    <TextBlock x:Name="FwChipText" Style="{StaticResource ChipText}" Text="…"/>
                  </Border>
                  <TextBlock x:Name="FwCurrentText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                             Style="{StaticResource Type.BodyStrong}"/>
                </Grid>
                <CheckBox x:Name="ForwardingEnabledCheckBox" Margin="0,12,0,0" Content="{x:Static local:L.FwToggle}"
                          Click="ForwardingToggle_Click"/>
                <Border Style="{StaticResource AdminNote}" Margin="0,12,0,0">
                  <DockPanel><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" DockPanel.Dock="Left"/><TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.FwApplyNote}"/></DockPanel>
                </Border>
                <Button x:Name="ApplyForwardingButton" Style="{StaticResource Button.Signal}" HorizontalAlignment="Right"
                        Margin="0,10,0,0" IsEnabled="False" Click="ApplyForwarding_Click">
                  <StackPanel Orientation="Horizontal"><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock VerticalAlignment="Center" Text="{x:Static local:L.FwApply}"/></StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionHeaderBar}">
              <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.FwAppsHeader}"/>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="AppsOffHint" Style="{StaticResource Type.Micro}" TextWrapping="Wrap"
                           Text="{x:Static local:L.FwAppsOffHint}"/>
                <StackPanel x:Name="AppSelectionPanel" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Margin="0,0,0,6"
                             Text="{x:Static local:L.FwAppsWhat}"/>
                  <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" MaxHeight="170"
                          Background="{StaticResource Brush.Surface}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                      <StackPanel x:Name="AppListPanel"/>
                    </ScrollViewer>
                  </Border>
                  <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="SaveAppsButton" DockPanel.Dock="Right" Style="{StaticResource Button.Signal}"
                            Content="{x:Static local:L.FwSave}" Click="SaveApps_Click"/>
                    <Button x:Name="RefreshAppsButton" DockPanel.Dock="Right" Style="{StaticResource Button.Carbon}"
                            Content="{x:Static local:L.Refresh}" Margin="0,0,6,0" Click="RefreshApps_Click"/>
                    <TextBlock x:Name="AppsStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                               Style="{StaticResource Type.BodyStrong}" Margin="0,0,8,0"/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ Watch list ═══ -->
      <TabItem x:Name="MonitorsTab" Header="{x:Static local:L.TabMonitors}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource SectionHeaderBar}">
                <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.MonHeader}"/>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.MonWhat}"/>

                  <DockPanel Margin="0,12,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Type.Micro}" Text="{x:Static local:L.MonProcessesEx}"/>
                    <TextBlock Style="{StaticResource Type.Label}" Text="{x:Static local:L.MonProcesses}"/>
                  </DockPanel>
                  <TextBox x:Name="ProcessesBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="52"
                           VerticalScrollBarVisibility="Auto" Margin="0,3,0,0" FontFamily="Consolas" TextChanged="Monitors_TextChanged"/>

                  <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Type.Micro}" Text="{x:Static local:L.MonServicesEx}"/>
                    <TextBlock Style="{StaticResource Type.Label}" Text="{x:Static local:L.MonServices}"/>
                  </DockPanel>
                  <TextBox x:Name="ServicesBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="52"
                           VerticalScrollBarVisibility="Auto" Margin="0,3,0,0" FontFamily="Consolas" TextChanged="Monitors_TextChanged"/>

                  <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Type.Micro}" Text="{x:Static local:L.MonHttpEx}"/>
                    <TextBlock Style="{StaticResource Type.Label}" Text="{x:Static local:L.MonHttp}"/>
                  </DockPanel>
                  <TextBox x:Name="HttpBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="52"
                           VerticalScrollBarVisibility="Auto" Margin="0,3,0,0" FontFamily="Consolas" TextChanged="Monitors_TextChanged"/>

                  <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Type.Micro}" Text="{x:Static local:L.MonTcpEx}"/>
                    <TextBlock Style="{StaticResource Type.Label}" Text="{x:Static local:L.MonTcp}"/>
                  </DockPanel>
                  <TextBox x:Name="TcpBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="52"
                           VerticalScrollBarVisibility="Auto" Margin="0,3,0,0" FontFamily="Consolas" TextChanged="Monitors_TextChanged"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Pinned under the fields so the save state is always in view. -->
          <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Border Style="{StaticResource AdminNote}">
              <DockPanel><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" DockPanel.Dock="Left"/><TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.MonSaveNote}"/></DockPanel>
            </Border>
            <DockPanel Margin="0,8,0,0" LastChildFill="True">
              <Button x:Name="SaveMonitorsButton" DockPanel.Dock="Right" Style="{StaticResource Button.Signal}"
                      IsEnabled="False" Click="SaveMonitors_Click">
                <StackPanel Orientation="Horizontal"><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock VerticalAlignment="Center" Text="{x:Static local:L.MonSave}"/></StackPanel>
              </Button>
              <TextBlock x:Name="MonitorsStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                         Style="{StaticResource Type.BodyStrong}" Margin="0,0,8,0"/>
            </DockPanel>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ═══ Updates & about ═══ -->
      <TabItem x:Name="UpdatesTab" Header="{x:Static local:L.TabUpdates}">
        <StackPanel>
          <Border Style="{StaticResource SectionHeaderBar}">
            <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.UpdHeader}"/>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock x:Name="UpdateVersionText" Style="{StaticResource Type.BodyStrong}"/>
              <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static local:L.UpdWhat}"/>
              <DockPanel Margin="0,10,0,0" LastChildFill="True">
                <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Style="{StaticResource Button.Signal}"
                        Content="{x:Static local:L.UpdCheck}" Click="CheckUpdate_Click"/>
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Type.Body}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SectionHeaderBar}">
            <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.AboutHeader}"/>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="AboutVersionText" Style="{StaticResource Type.BodyStrong}" Text="Homebase"/>
              <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Text="{x:Static local:L.AboutLine}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>

    <Button Grid.Row="2" Style="{StaticResource Button.Carbon}" Content="{x:Static local:L.Close}"
            HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
  </Grid>
</local:ThemedWindow>
