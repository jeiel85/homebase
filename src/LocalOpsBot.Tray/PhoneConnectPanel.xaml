<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.PhoneConnectPanel">
  <!-- The Settings window's "Phone" tab. Same top-down order as the other tabs:
       what this does → current state → change it (APPLY/ENABLE asks for UAC). -->
  <StackPanel>
    <Border Style="{StaticResource SectionHeaderBar}">
      <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.PhoneHeader}"/>
    </Border>

    <Border Style="{StaticResource Card}">
      <TextBlock x:Name="StatusText" Style="{StaticResource Type.Body}" TextWrapping="Wrap"
                 Text="상태를 확인하는 중…"/>
    </Border>

    <!-- Feature off: what it does -->
    <Border x:Name="IntroCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap">
        휴대폰 앱에서 이 PC의 열린 창과 프로세스별 CPU·RAM·I/O·네트워크를 실시간으로 보고, PC 알림을 앱 푸시로 받습니다.
        QR 한 번이면 앱이 알아서 경로를 고릅니다: 같은 Wi-Fi면 LAN(TLS 암호화), 밖에서는 Tailscale 또는
        Cloudflare Tunnel. Tailscale이 없어도 됩니다. 휴대폰이 보고 있을 때만 수집하며, 켜려면 관리자 승인(UAC)이 한 번 필요합니다.
      </TextBlock>
    </Border>

    <!-- Feature on: QR code, path status, paired devices -->
    <StackPanel x:Name="PairPanel" Visibility="Collapsed" Margin="0,12,0,0">
      <Border Style="{StaticResource Card}" HorizontalAlignment="Center" Padding="10">
        <Image x:Name="QrImage" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>
      <TextBlock x:Name="CountdownText" Style="{StaticResource Type.BodyStrong}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
        <Button x:Name="NewCodeButton" Style="{StaticResource Button.Carbon}" Content="{x:Static local:L.PhoneNewCode}"
                Click="NewCode_Click"/>
        <Button x:Name="CopyLinkButton" Style="{StaticResource Button.Carbon}" Content="{x:Static local:L.PhoneCopyLink}"
                Margin="8,0,0,0" Click="CopyLink_Click"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                 Margin="0,6,0,0" Text="{x:Static local:L.PhoneCopyLinkHint}"/>
    </StackPanel>

    <StackPanel x:Name="PathsPanel" Visibility="Collapsed">
      <Border Style="{StaticResource SectionHeaderBar}" Margin="0,14,0,8">
        <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.PhonePaths}"/>
      </Border>
      <ItemsControl x:Name="PathList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Carbon}" Content="{Binding ActionLabel}"
                        Tag="{Binding ActionKey}" Visibility="{Binding ActionVisibility}" Click="PathAction_Click"
                        VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                <StackPanel>
                  <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{Binding Title}"/>
                  <TextBlock Style="{StaticResource Type.Micro}" Text="{Binding Detail}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel x:Name="DevicesPanel" Visibility="Collapsed">
      <Border Style="{StaticResource SectionHeaderBar}" Margin="0,14,0,8">
        <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.PhonePaired}"/>
      </Border>
      <TextBlock x:Name="NoDevicesText" Style="{StaticResource Type.Body}" Text="아직 연결된 휴대폰이 없습니다."/>
      <ItemsControl x:Name="DeviceList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Carbon}" Content="{x:Static local:L.PhoneRevoke}"
                        Tag="{Binding DeviceId}" Click="Revoke_Click" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{Binding Name}"/>
                  <TextBlock Style="{StaticResource Type.Micro}" Text="{Binding Detail}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Link another PC (DECISIONS M-29): paste that PC's pairing link; both then see each other's state and notifications. -->
    <StackPanel x:Name="LinkPanel" Visibility="Collapsed">
      <Border Style="{StaticResource SectionHeaderBar}" Margin="0,14,0,8">
        <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.PhoneLinkHeader}"/>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.PhoneLinkIntro}"/>
          <DockPanel Margin="0,8,0,0">
            <Button x:Name="LinkButton" DockPanel.Dock="Right" Style="{StaticResource Button.Signal}" Content="{x:Static local:L.PhoneLinkButton}"
                    Margin="8,0,0,0" Click="Link_Click"/>
            <TextBox x:Name="LinkBox" VerticalContentAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="LinkResultText" Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <ItemsControl x:Name="HubList" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Carbon}" Content="{x:Static local:L.PhoneUnlink}"
                        Tag="{Binding PcId}" Click="Unlink_Click" VerticalAlignment="Center"/>
                <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                <StackPanel>
                  <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{Binding Name}"/>
                  <TextBlock Style="{StaticResource Type.Micro}" Text="{Binding Detail}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Which paths to open; shown in both states (ENABLE when off, APPLY when on) -->
    <Border Style="{StaticResource SectionHeaderBar}" Margin="0,14,0,8">
      <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.PhonePathSettings}"/>
    </Border>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox x:Name="LanCheck" IsChecked="True" Margin="0,0,0,2">
          <TextBlock Style="{StaticResource Type.Body}" Text="같은 Wi-Fi·유선 (LAN, TLS)"/>
        </CheckBox>
        <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Margin="20,0,0,8"
                   Text="같은 네트워크면 가장 빠릅니다. Windows 네트워크가 '개인'일 때만 열립니다."/>
        <CheckBox x:Name="TailscaleCheck" IsChecked="True" Margin="0,0,0,2">
          <TextBlock Style="{StaticResource Type.Body}" Text="Tailscale"/>
        </CheckBox>
        <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Margin="20,0,0,8"
                   Text="PC와 휴대폰이 같은 tailnet에 있으면 어디서든 직접 연결합니다."/>
        <CheckBox x:Name="CloudflareCheck" IsChecked="True" Margin="0,0,0,2"
                  Checked="CloudflareCheck_Changed" Unchecked="CloudflareCheck_Changed">
          <TextBlock Style="{StaticResource Type.Body}" Text="Cloudflare Tunnel (외부, Tailscale 없이)"/>
        </CheckBox>
        <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Margin="20,0,0,4"
                   Text="비워 두면 계정 없는 Quick Tunnel(임시 주소, PC 재시작마다 바뀜)을 씁니다. 고정 주소는 Cloudflare 대시보드의 터널 토큰과 호스트명을 넣으세요."/>
        <StackPanel x:Name="CloudflareFields" Margin="20,0,0,0">
          <TextBlock Style="{StaticResource Type.Micro}" Text="터널 토큰 (선택)" Margin="0,4,0,2"/>
          <PasswordBox x:Name="TunnelTokenBox"/>
          <TextBlock x:Name="TokenSavedText" Style="{StaticResource Type.Micro}" Visibility="Collapsed"
                     Text="저장된 토큰이 있습니다. 비워 두면 유지되고, 호스트명까지 지우면 Quick Tunnel로 돌아갑니다."/>
          <TextBlock Style="{StaticResource Type.Micro}" Text="공개 호스트명 (토큰을 쓸 때 필수, 예: home-pc.example.com)" Margin="0,6,0,2"/>
          <TextBox x:Name="TunnelHostBox"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource AdminNote}" Margin="0,12,0,0">
      <DockPanel><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" DockPanel.Dock="Left"/><TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.PhoneApplyNote}"/></DockPanel>
    </Border>
    <Button x:Name="ApplyButton" Style="{StaticResource Button.Signal}"
            HorizontalAlignment="Right" Margin="0,10,0,0" Click="Apply_Click">
      <StackPanel Orientation="Horizontal"><Image Source="{x:Static local:UacShield.Source}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock x:Name="ApplyButtonText" VerticalAlignment="Center" Text="ENABLE"/></StackPanel>
    </Button>
  </StackPanel>
</UserControl>
