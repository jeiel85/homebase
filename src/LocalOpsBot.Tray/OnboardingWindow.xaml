<local:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.OnboardingWindow"
        Style="{StaticResource Window.Chrome}"
        Title="{x:Static local:L.SetupTitle}"
        Icon="pack://application:,,,/Resources/homebase.ico"
        Width="460" Height="620"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Display">
  <!-- A checklist only: each row is state + what to do next. Inputs live in Settings so there is
       exactly one place to enter or change the Telegram connection. -->
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource SectionHeaderBar}" Margin="0,0,0,12" Padding="10,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}" FontWeight="Black"
                   FontSize="16" Foreground="{StaticResource Brush.OnDark}" Text="HOMEBASE"/>
        <TextBlock VerticalAlignment="Center" Margin="8,3,0,0" Style="{StaticResource Type.Micro}"
                   Foreground="{StaticResource Brush.Amber}" Text="{x:Static local:L.SetupEyebrow}"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="12"
                BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap" Text="{x:Static local:L.SetupIntro}"/>
        </Border>

        <!-- ═ REQUIRED ═ -->
        <Border Style="{StaticResource SectionHeaderBar}">
          <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.SetupRequired}"/>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="ServiceChip" Style="{StaticResource Chip}">
                <TextBlock x:Name="ServiceChipText" Style="{StaticResource ChipText}" Text="…"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{x:Static local:L.SetupService}"/>
                <TextBlock x:Name="ServiceStatusText" Style="{StaticResource Type.Micro}" TextWrapping="Wrap"
                           Text="{x:Static local:L.BadgeChecking}"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,10,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="TelegramChip" Style="{StaticResource Chip}" VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock x:Name="TelegramChipText" Style="{StaticResource ChipText}" Text="…"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{x:Static local:L.SetupTelegram}"/>
                <TextBlock x:Name="TelegramStatusText" Style="{StaticResource Type.Micro}" TextWrapping="Wrap"
                           Text="{x:Static local:L.BadgeChecking}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="ConnectTelegramButton" Style="{StaticResource Button.Signal}"
                          Content="{x:Static local:L.SetupConnectTelegram}" Click="ConnectTelegram_Click"/>
                  <Button x:Name="TestButton" Style="{StaticResource Button.Carbon}" Margin="6,0,0,0"
                          Content="{x:Static local:L.SendTest}" Click="TestMessage_Click" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="TestResultText" Style="{StaticResource Type.BodyStrong}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ═ OPTIONAL ═ -->
        <Border Style="{StaticResource SectionHeaderBar}">
          <TextBlock Style="{StaticResource Type.SectionLabel}" Text="{x:Static local:L.SetupOptional}"/>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="OllamaChip" Style="{StaticResource Chip}" VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock x:Name="OllamaChipText" Style="{StaticResource ChipText}" Text="…"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{x:Static local:L.SetupAi}"/>
                <TextBlock x:Name="OllamaStatusText" Style="{StaticResource Type.Micro}" TextWrapping="Wrap"
                           Text="{x:Static local:L.BadgeChecking}"/>

                <TextBlock x:Name="OllamaInstallHint" Visibility="Collapsed" Margin="0,6,0,0"
                           FontFamily="{StaticResource Font.Sans}" FontSize="12" FontWeight="Bold">
                  <Hyperlink NavigateUri="https://ollama.com/download" RequestNavigate="Hyperlink_RequestNavigate"
                             Foreground="{StaticResource Brush.InkSoft}"><Run Text="{x:Static local:L.OllamaGet}"/></Hyperlink>
                </TextBlock>

                <Button x:Name="OllamaStartButton" Visibility="Collapsed" Style="{StaticResource Button.Amber}"
                        Content="{x:Static local:L.OllamaStart}" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Click="OllamaStart_Click"/>

                <StackPanel x:Name="OllamaPullHint" Visibility="Collapsed" Margin="0,6,0,0">
                  <TextBlock x:Name="OllamaPullCommand" FontFamily="Consolas" FontSize="12"
                             Foreground="{StaticResource Brush.Ink}" TextWrapping="Wrap" Text="ollama pull …"/>
                  <Button x:Name="OllamaPullButton" Style="{StaticResource Button.Amber}"
                          Content="{x:Static local:L.OllamaPull}" Margin="0,6,0,0" HorizontalAlignment="Left"
                          Click="OllamaPull_Click"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Grid Margin="0,12,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Chip}" Background="{StaticResource Brush.Hairline}" VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock Style="{StaticResource ChipText}" Text="{x:Static local:L.ChipOptional}"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{x:Static local:L.SetupTemp}"/>
                <TextBlock Style="{StaticResource Type.Micro}" TextWrapping="Wrap" Text="{x:Static local:L.SetupTempText}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="RecheckButton" Style="{StaticResource Button.Amber}" Content="{x:Static local:L.Recheck}" Click="Recheck_Click"/>
      <Button Style="{StaticResource Button.Carbon}" Content="{x:Static local:L.SetupGetStarted}" Margin="8,0,0,0" Click="GetStarted_Click"/>
    </StackPanel>
  </Grid>
</local:ThemedWindow>
