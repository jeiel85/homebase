<local:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.DashboardWindow"
        Style="{StaticResource Window.Chrome}"
        Title="Homebase"
        Icon="pack://application:,,,/Resources/homebase.ico"
        Width="980" Height="680" MinWidth="780" MinHeight="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#E3E7F3"
        FontFamily="Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
  <!-- The Homebase window: three pages picked in the masthead (DECISIONS M-49) — Devices, the notification
       center and Settings, which used to open windows of their own. Each page has a list down the left.
       Devices is the device hub (M-46): every device on the left, the selected one on the right — this
       PC, linked PCs (live, like the phone app's PC page) and phones (their last report). Read-only
       but for aliases (M-50, M-51: the pencil, F2, or a tile's right-click menu);
       configuration is the Settings page. -->
  <local:ThemedWindow.Resources>
    <!-- A slim, quiet scrollbar on the light page (the theme's periwinkle rail is for the chrome windows). -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" Background="#B9C2DE" CornerRadius="3" Margin="1,2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="t" Property="Background" Value="#8BA1D4"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </local:ThemedWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ═ Masthead: wordmark, the three pages, service state ═ -->
    <Border Grid.Row="0" Background="#21242E" Padding="18,7,14,7">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,18,0"
                   FontFamily="Segoe UI Black, Arial Black" FontWeight="Black"
                   FontSize="17" Foreground="White" Text="HOMEBASE"/>
        <RadioButton x:Name="NavDevices" DockPanel.Dock="Left" GroupName="DashNav" Style="{StaticResource Dash.NavTab}"
                     IsChecked="True" Checked="Nav_Checked" Content="{x:Static local:L.NavDevices}"/>
        <!-- The unread count floats over the tab's top-right corner, like the phone app's bell badge,
             so the tab keeps its width when the count comes and goes (it used to be part of the label,
             and reading the notifications shortened the tab and moved Settings). Drawn above Settings. -->
        <RadioButton x:Name="NavNotifications" DockPanel.Dock="Left" GroupName="DashNav" Style="{StaticResource Dash.NavTab}"
                     Margin="2,0,0,0" Checked="Nav_Checked" Panel.ZIndex="1">
          <Grid>
            <TextBlock Text="{x:Static local:L.NavNotificationsLabel}"/>
            <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
              <Border x:Name="UnreadBadge" Canvas.Left="1" Canvas.Top="-8" MinWidth="16" Height="16"
                      CornerRadius="8" Padding="3,0" Background="#ECAB37" Visibility="Collapsed"
                      IsHitTestVisible="False">
                <TextBlock x:Name="UnreadText" FontSize="10" FontWeight="Bold" Foreground="#21242E"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Canvas>
          </Grid>
        </RadioButton>
        <RadioButton x:Name="NavSettings" DockPanel.Dock="Left" GroupName="DashNav" Style="{StaticResource Dash.NavTab}"
                     Margin="2,0,0,0" Checked="Nav_Checked" Content="{x:Static local:L.NavSettings}"/>
        <Border x:Name="StatusBadge" DockPanel.Dock="Right" VerticalAlignment="Center"
                Background="#3A3F50" CornerRadius="11" Padding="10,3,11,4">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusLed" Width="8" Height="8" Fill="#8A90A8" VerticalAlignment="Center"/>
            <TextBlock x:Name="AgentStatusText" Margin="7,0,0,0" Text="{x:Static local:L.BadgeChecking}"
                       Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ═ Notifications and Settings pages (out of view until picked) ═ -->
    <local:NotificationCenterPanel x:Name="CenterView" Grid.Row="1" Visibility="Collapsed"/>
    <local:SettingsPanel x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"/>

    <!-- ═ Devices page ═ -->
    <Grid x:Name="DevicesView" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="268"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ═ Device list ═ -->
      <Border Grid.Column="0" Background="#F4F6FB" BorderBrush="#C9CFE3" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="10,12,10,8">
            <StackPanel x:Name="RailPanel"/>
          </ScrollViewer>
          <Border Grid.Row="1" BorderBrush="#C9CFE3" BorderThickness="0,1,0,0" Padding="10">
            <Button x:Name="AddDeviceButton" Style="{StaticResource Dash.AddButton}" Click="AddDevice_Click"
                    Content="{x:Static local:L.DashAddDevice}"/>
          </Border>
        </Grid>
      </Border>

      <!-- ═ Selected device ═ -->
      <ScrollViewer x:Name="DetailScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">
          <Grid x:Name="DetailHeader" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderGlyphBox" Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                    Background="#21242E" VerticalAlignment="Top" Margin="0,2,14,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <!-- Left-aligned so the pencil sits right after the name; a long name trims before it. -->
              <DockPanel HorizontalAlignment="Left">
                <Button x:Name="RenameButton" DockPanel.Dock="Right" Click="Rename_Click"
                        ToolTip="{x:Static local:L.AliasTip}" Cursor="Hand" Focusable="False"
                        VerticalAlignment="Center" Margin="6,3,0,0">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="bd" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                        <TextBlock x:Name="ic" Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="#4A5180"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="#D3D9EC"/>
                          <Setter TargetName="ic" Property="Foreground" Value="#21242E"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <TextBlock x:Name="HeaderName" FontSize="22" FontWeight="Bold" Foreground="#21242E"
                           TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <TextBlock x:Name="HeaderSub" FontSize="12" Foreground="#4A5180" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis"/>
              <WrapPanel x:Name="HeaderChips" Margin="0,8,0,0"/>
            </StackPanel>
            <Border x:Name="LivePill" Grid.Column="2" VerticalAlignment="Top" Margin="12,4,0,0"
                    Background="White" BorderBrush="#C9CFE3" BorderThickness="1" CornerRadius="12" Padding="10,4,12,5">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LiveLed" Width="8" Height="8" Fill="#8A90A8" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveText" Margin="7,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#21242E" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border x:Name="WarningBox" Visibility="Collapsed" Background="#FFF4DD" BorderBrush="#ECAB37"
                  BorderThickness="3,0,0,0" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap" FontSize="12" Foreground="#21242E"/>
          </Border>
          <ContentControl x:Name="DetailHost"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</local:ThemedWindow>
