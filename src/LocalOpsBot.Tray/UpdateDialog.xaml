<local:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.UpdateDialog"
        Style="{StaticResource Window.Chrome}"
        Title="Homebase Update"
        Icon="pack://application:,,,/Resources/homebase.ico"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource SectionHeaderBar}" Margin="0,0,0,8">
      <TextBlock x:Name="TitleText" Style="{StaticResource Type.SectionLabel}" Text="UPDATE AVAILABLE"/>
    </Border>

    <TextBlock Grid.Row="1" x:Name="MetaText" Style="{StaticResource Type.Label}"
               Foreground="{StaticResource Brush.OnDark}" Margin="2,0,0,8"/>

    <!-- Release notes: the CHANGELOG section of the release, scrollable when long. -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
      <FlowDocumentScrollViewer x:Name="NotesViewer" Height="320"
                                IsToolBarVisible="False" Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"/>
    </Border>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" x:Name="SkipButton" Style="{StaticResource Button.Carbon}"
              Content="SKIP THIS VERSION" Click="Skip_Click"/>
      <Button Grid.Column="2" x:Name="LaterButton" Style="{StaticResource Button.Carbon}"
              Content="LATER" Margin="0,0,8,0" Click="Later_Click" IsCancel="True"/>
      <Button Grid.Column="3" x:Name="UpdateButton" Style="{StaticResource Button.Signal}"
              Content="UPDATE NOW" Click="Update_Click" IsDefault="True"/>
    </Grid>
  </Grid>
</local:ThemedWindow>
