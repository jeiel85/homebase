<local:ThemedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalOpsBot.Tray"
        x:Class="LocalOpsBot.Tray.MobileConnectWindow"
        Style="{StaticResource Window.Chrome}"
        Title="Homebase — 휴대폰 연결"
        Icon="pack://application:,,,/Resources/homebase.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Sans}"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="14">
    <Border Style="{StaticResource SectionHeaderBar}" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource Type.SectionLabel}" Text="CONNECT PHONE"/>
    </Border>

    <Border Style="{StaticResource Card}">
      <TextBlock x:Name="StatusText" Style="{StaticResource Type.Body}" TextWrapping="Wrap"
                 Text="상태를 확인하는 중…"/>
    </Border>

    <!-- Feature off: one elevated step turns it on -->
    <StackPanel x:Name="EnablePanel" Visibility="Collapsed" Margin="0,12,0,0">
      <Border Style="{StaticResource Card}">
        <TextBlock Style="{StaticResource Type.Body}" TextWrapping="Wrap">
          휴대폰 앱에서 이 PC의 열린 창과 프로세스별 CPU·RAM·I/O·네트워크를 실시간으로 봅니다.
          연결은 Tailscale 망 안에서만 열리고(인터넷·LAN에는 열리지 않음), 휴대폰이 보고 있을 때만 수집합니다.
          켜려면 관리자 승인(UAC)이 한 번 필요합니다.
        </TextBlock>
      </Border>
      <Button x:Name="EnableButton" Style="{StaticResource Button.Signal}" Content="ENABLE"
              HorizontalAlignment="Right" Margin="0,12,0,0" Click="Enable_Click"/>
    </StackPanel>

    <!-- Feature on: QR code + paired devices -->
    <StackPanel x:Name="PairPanel" Visibility="Collapsed" Margin="0,12,0,0">
      <Border Style="{StaticResource Card}" HorizontalAlignment="Center" Padding="10">
        <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Border>
      <TextBlock x:Name="CountdownText" Style="{StaticResource Type.BodyStrong}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      <TextBlock x:Name="HostsText" Style="{StaticResource Type.Micro}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
      <Button x:Name="NewCodeButton" Style="{StaticResource Button.Carbon}" Content="NEW CODE"
              HorizontalAlignment="Center" Margin="0,10,0,0" Click="NewCode_Click"/>

      <Border Style="{StaticResource SectionHeaderBar}" Margin="0,14,0,8">
        <TextBlock Style="{StaticResource Type.SectionLabel}" Text="PAIRED PHONES"/>
      </Border>
      <TextBlock x:Name="NoDevicesText" Style="{StaticResource Type.Body}" Text="아직 연결된 휴대폰이 없습니다."/>
      <ItemsControl x:Name="DeviceList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Carbon}" Content="REVOKE"
                        Tag="{Binding DeviceId}" Click="Revoke_Click" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Style="{StaticResource Type.BodyStrong}" Text="{Binding Name}"/>
                  <TextBlock Style="{StaticResource Type.Micro}" Text="{Binding Detail}"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</local:ThemedWindow>
