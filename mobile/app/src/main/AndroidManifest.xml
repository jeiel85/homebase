<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by every distribution channel. The GitHub build's in-app updater (permission, job, file
     provider) lives in src/github/AndroidManifest.xml and is absent from the Play build (DECISIONS M-33). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Route choice: is the phone on the PC's Wi-Fi subnet, is the Tailscale VPN up (DECISIONS M-18). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- PC alerts and forwarded Windows notifications arrive by UnifiedPush (DECISIONS M-19). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the background jobs scheduled across reboots (JobInfo.setPersisted): presence (M-27), and the
         GitHub build's update check (M-22). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 14+: files to a PC go as a user-initiated data transfer job, which runs until done and shows its
         own progress (DECISIONS M-64). No foreground service. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Find installed UnifiedPush distributors (ntfy, …); package visibility on API 30+. -->
    <queries>
        <intent>
            <action android:name="org.unifiedpush.android.distributor.REGISTER" />
        </intent>
        <!-- App names for forwarded notifications (DECISIONS M-28): launcher apps only, not every package. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Homebase"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Homebase"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing QR link (DECISIONS M-20). Verified App Link once jeiel85.github.io serves
                 /.well-known/assetlinks.json; until then the install page's button opens the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="jeiel85.github.io" android:pathPrefix="/homebase/pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="homebase" android:host="pair" />
            </intent-filter>
            <!-- The share sheet's PC shortcuts (Direct Share, Android 10+): res/xml/shortcuts.xml declares the share target. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- "Homebase" in the share sheet: the share center (docs/SHARE_CONVENIENCE.md §9), where text and files go to
             the PCs and phones the user checks (DECISIONS M-62, M-64). Exported for the share sheet and its PC shortcuts;
             nothing is sent until the user taps [공유 시작], so another app can't push text or files to a PC by itself —
             not even with a shortcut id, which only checks that PC. Its own task, so sharing doesn't bring the app's
             screens up. -->
        <activity
            android:name=".clip.ClipShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Homebase.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Files and pictures, one or several, of any type (DECISIONS M-64). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Files to a PC (M-64): the upload job, and the cancel action on its notification. Only the system binds
             the job; only this app's own notification reaches the receiver. -->
        <service
            android:name=".share.UploadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".share.UploadCancelReceiver"
            android:exported="false" />

        <!-- Files a PC sends (M-65): the download job and the cancel action on its notification. -->
        <service
            android:name=".share.DownloadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".share.DownloadCancelReceiver"
            android:exported="false" />

        <!-- Android 8–9 keep received files in this app's own folder; this hands them to the app that opens or
             shares them. Its own class and authority: the GitHub build's updater has the plain FileProvider. -->
        <provider
            android:name=".share.ReceivedFileProvider"
            android:authorities="${applicationId}.received"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/received_paths" />
        </provider>

        <!-- The tile's clipboard send and a "long text" notification's fetch (M-62), and a PC card's "파일 보내기"
             (M-64). Not exported: reading the clipboard and sending it on is only ever started by this app. -->
        <activity
            android:name=".clip.ClipActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Homebase.Translucent" />

        <!-- Quick settings tile "클립보드 → PC" (M-62). Only the system binds it. -->
        <service
            android:name=".clip.ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/clip_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- zxing's scanner activity, locked to portrait like the rest of the app. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <!-- UnifiedPush connector (AND_3). Exported because the distributor is another app;
             broadcasts are checked against our token and must decrypt with our key. -->
        <receiver
            android:name=".push.PushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.TEMP_UNAVAILABLE" />
            </intent-filter>
        </receiver>

        <!-- A bundled push was swiped away: drops the bundle's summary once it is empty (DECISIONS M-37).
             Only this app's own notifications (their delete intent) reach it. -->
        <receiver
            android:name=".push.NotificationDismissReceiver"
            android:exported="false" />

        <!-- Allow / Deny on a Claude Code permission prompt (DECISIONS M-48). Only this app's own
             notification actions reach it. -->
        <receiver
            android:name=".push.ApprovalActionReceiver"
            android:exported="false" />

        <!-- [취소] on a restart counting down on a PC (DECISIONS M-69). Only this app's own notification
             action reaches it. -->
        <receiver
            android:name=".command.RestartCancelReceiver"
            android:exported="false" />

        <service
            android:name=".push.RaiseToForegroundService"
            android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" />
            </intent-filter>
        </service>

        <!-- Tells the paired PCs this phone's state every ~30 min (DECISIONS M-27). -->
        <service
            android:name=".mesh.PresenceJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Forwards this phone's notifications to the PCs (DECISIONS M-28). Only runs once the user
             grants notification access; the in-app switch (off by default) gates it again. -->
        <service
            android:name=".mesh.NotificationForwarder"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
