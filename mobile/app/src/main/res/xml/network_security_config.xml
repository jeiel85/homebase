<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is only used on the Tailscale path (100.64.0.0/10 or *.ts.net), where WireGuard
     encrypts the hop (DECISIONS M-2). LAN uses TLS pinned to the PC's certificate (M-15) and the
     Cloudflare Tunnel uses public TLS (M-17). The updater enforces https itself. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
